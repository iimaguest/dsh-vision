{
  "name": "dsh-vision",
  "description": "Vision inspection for DeepSeek Harness: the ctx.vision capability seam, the DeepSeek view provider, and the model-facing view_image tool — bundled as one installable plugin.",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iimaguest/dsh-vision.git"
  },
  "type": "module",
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./vision-deepseek": {
      "types": "./lib/types/vision-deepseek/index.d.ts",
      "default": "./lib/types/vision-deepseek/index.js"
    },
    "./tool-vision": {
      "types": "./lib/types/tool-vision/index.d.ts",
      "default": "./lib/types/tool-vision/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/types/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "Apache-2.0",
  "author": "iimaguest",
  "bugs": {
    "url": "https://github.com/iimaguest/dsh-vision/issues"
  },
  "homepage": "https://github.com/iimaguest/dsh-vision#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "vision",
    "image",
    "view-image"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "node -e \"console.log('dsh-vision: lib ships prebuilt; nothing to prepare')\"",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-attachment": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-credentials": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-fs": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-invariants": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-launch-environment": ">=0.0.1-rc.3",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-sandbox": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-attachment": { "optional": true },
    "@deepseek-ai/dsh-credentials": { "optional": true },
    "@deepseek-ai/dsh-fs": { "optional": true },
    "@deepseek-ai/dsh-invariants": { "optional": true },
    "@deepseek-ai/dsh-launch-environment": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-sandbox": { "optional": true },
    "@deepseek-ai/dsh-system-prompt": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
